{
    "name": "libamr",
    "description": "AMR narrowband and wideband decoder",
    "filters":["amrdec"],
    "help": "This filter decodes AMR-NB and AMR-WB speech files using opencore-amr.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libamr.accessor",
    "filter_source":{
        "amrdec" : "dec_amr.c"
    },
    "extension":{
      "amr" : "audio",
      "awb" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "under-review",
        "note": "AMR-NB/AMR-WB",
        "checked": "2026-10-16"
    }
}
